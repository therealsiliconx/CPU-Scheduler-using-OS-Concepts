# ---------------------------------------------------------------------------
#  Makefile  -  Mini CPU Scheduler (OS Lab project)
#
#    make            build scheduler, logger and report
#    make run        quick demo (Round Robin, quantum 2, jobs1.txt)
#    make results    regenerate results.txt (comparison tables, all inputs)
#    make bonus      run the context-switch-cost experiment
#    make test       run the validation tests with bad input files
#    make clean      remove binaries, schedule.log
# ---------------------------------------------------------------------------
CC      = gcc
CFLAGS  = -std=c11 -Wall -Wextra -pthread -O2
LDLIBS  = -pthread -lrt

INPUTS  = inputs/jobs1.txt inputs/jobs2.txt inputs/jobs3.txt inputs/jobs4.txt

all: scheduler logger report

scheduler: src/scheduler.c src/common.h
	$(CC) $(CFLAGS) -o $@ src/scheduler.c $(LDLIBS)

logger: src/logger.c
	$(CC) $(CFLAGS) -o $@ src/logger.c

report: src/report.c src/common.h
	$(CC) $(CFLAGS) -o $@ src/report.c $(LDLIBS)

run: all
	./scheduler inputs/jobs1.txt rr 2

bonus: all
	./scheduler inputs/jobs1.txt all 2 --cs-cost 1 --unit-ms 20
	./scheduler inputs/jobs4.txt sweep --cs-cost 1

# results.txt: comparison tables for every input (fast clock: 1 ms per unit)
results: all
	@rm -f results.txt
	@echo "Mini CPU Scheduler - comparison tables (all mode, quantum = 2)" >> results.txt
	@echo "Generated by: make results" >> results.txt
	@for f in $(INPUTS); do \
	    echo "" >> results.txt; \
	    echo "==============================================================================" >> results.txt; \
	    ./scheduler $$f all 2 --unit-ms 1 --table-only >> results.txt || exit 1; \
	done
	@echo "" >> results.txt
	@echo "==============================================================================" >> results.txt
	@echo "BONUS - same inputs with a context-switch cost of 1 time unit" >> results.txt
	@for f in $(INPUTS); do \
	    ./scheduler $$f all 2 --unit-ms 1 --table-only --cs-cost 1 >> results.txt || exit 1; \
	done
	@echo "" >> results.txt
	@echo "==============================================================================" >> results.txt
	@echo "BONUS - Round Robin quantum sweep" >> results.txt
	@for f in inputs/jobs1.txt inputs/jobs4.txt; do \
	    echo "" >> results.txt; \
	    ./scheduler $$f sweep --cs-cost 1 >> results.txt || exit 1; \
	done
	@echo "results.txt written"

# Input-validation tests: every command must be REJECTED with a clear message.
test: all
	@for f in inputs/bad_*.txt does_not_exist.txt; do \
	    echo "--- $$f"; ./scheduler $$f fcfs; echo "exit code: $$?"; \
	done

clean:
	rm -f scheduler logger report schedule.log

.PHONY: all run bonus results test clean
